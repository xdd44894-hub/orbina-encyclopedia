---
layout: null
permalink: /search.json
---
{% assign current_articles = site.articles | where_exp: "article", "article.archived != true" %}
[
{% for article in current_articles %}
{"title":{{ article.title | jsonify }},"category":{{ article.category | jsonify }},"source":{{ article.source | jsonify }},"url":{{ article.url | relative_url | jsonify }},"text":{{ article.content | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
