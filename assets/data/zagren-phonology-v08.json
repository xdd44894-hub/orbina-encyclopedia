      "note": "明示方言顺序和相互独立的音变"
    },
    {
      "id": "H4",
      "name": "V0.8词族类推与跨词性一致",
      "rules": [
        "N13-F-LIVE",
        "N13-F-LIVE-ADJ",
        "N13-F-LIVE-PTCP",
        "SE12-F-WINTER"
      ],
      "note": "4条仅限具体词族的延伸，不能泛化"
    },
    {
      "id": "H5",
      "name": "历史格位与现行表面形式",
      "note": "形态词干/词尾相互作用；西部主格词尾弱化不意味着所有格都弱化"
    },
    {
      "id": "H6",
      "name": "实际语流与词汇重音",
      "status": "pending",
      "note": "未给IPA写入假定重音或未验证的连读"
    }
  ],
  "inheritedSoundLaws": [
    {
      "id": "C01",
      "scope": "三地",
      "description": "词根内部 /l,ɫ/ + 弱读 /o/ + /k,d/ 的元音脱落",
      "example": "ħolod→ħold / holod→hold / ħołod→ħołd；moloko→molko",
      "caveat": "限于可确认弱读的词根；不机械删除全部o"
    },
    {
      "id": "C02",
      "scope": "三地",
      "description": "边界类派生词中 -nic(a) / -nic 失去弱读 i，成为 -nc(a) / -nc",
      "example": "ġranica→ġranca；granica→granca；ġranic→ġranc",
      "caveat": "现阶段仅验证这一派生词族"
    },
    {
      "id": "C03",
      "scope": "三地",
      "description": "高频弱读副词 ešče 的 e- 脱落及 šč > š 合流",
      "example": "ešče→še",
      "caveat": "词汇化缩约，不任意推广到所有 šč 词根"
    },
    {
      "id": "C04",
      "scope": "三地",
      "description": "高频风词词干末 -etr > -er（/t/ 在复杂韵尾中脱落）",
      "example": "ŵetr→ŵer；vetr→ver",
      "caveat": "暂限气象词及经验证的同源词"
    },
    {
      "id": "N11",
      "scope": "北部",
      "description": "词首 /sne/ > /sę/（鼻音失去辅音地位，元音鼻化）",
      "example": "sneġ→sęġ",
      "caveat": "也可作用于复合词词根的起始位置"
    },
    {
      "id": "N12",
      "scope": "北部",
      "description": "历史软音节尾触发 /o/ 前化为 /ø/，后经类推推广到全词干",
      "example": "oġń→ӧġń；kośť→kӧśť",
      "caveat": "词干音变；不能见软音就无条件换字"
    },
    {
      "id": "N13",
      "scope": "北部",
      "description": "/ʒ/ 在后接 /e,i/ 环境软化成 /ʑ/，写ẑ",
      "example": "železo→ẑelezo；žiŵot→ẑiŵot",
      "caveat": "不影响后接 a、o 的 ž"
    },
    {
      "id": "N14",
      "scope": "北部",
      "description": "历史 /tʲr/ > /tʰr/；新增字母 ṱ = /tʰ/，区别于 ť、t",
      "example": "ťruba→ṱruba；ťrubu→ṱrubu",
      "caveat": "仅该音丛起源，不把所有t变送气"
    },
    {
      "id": "N15",
      "scope": "北部",
      "description": "高频中性时间词 utro 末尾 -o 弱化脱落",
      "example": "utro→utr",
      "caveat": "词形类推后需重新推导变格"
    },
    {
      "id": "N16",
      "scope": "北部",
      "description": "新祖语软化辅音 /kʲ,rʲ/ 后 /u/ 前化为 /y/，写 ү",
      "example": "*kʲuta→ǩүta；*rʲud→rjүd",
      "caveat": "不能把普通u全部换成ү"
    },
    {
      "id": "N17",
      "scope": "北部",
      "description": "新祖语 *kʲ > ǩ，*dj > ď，*rʲ > rj",
      "example": "*kʲel→ǩel；*medja→meďa；*rʲud→rjүd",
      "caveat": "新增祖语词根的示范性演变"
    },
    {
      "id": "SE11",
      "scope": "东南",
      "description": "词首 /sne/ > /se/，失去鼻音但不保留鼻化",
      "example": "sneg→seg",
      "caveat": "与北部N11形成同源对应"
    },
    {
      "id": "SE12",
      "scope": "东南",
      "description": "/z/ 在 /i/ 前软化为 /ʑ/，写ẑ",
      "example": "zima→ẑima",
      "caveat": "先验证稳定的该词根"
    },
    {
      "id": "SE13",
      "scope": "东南",
      "description": "/o/ 在 /l/ 之前于指定词根中央化为 /ɵ/，写ȯ",
      "example": "holod→hȯld；moloko→mȯlko",
      "caveat": "同期先应用C01；需核对其他含ol词根"
    },
    {
      "id": "SE14",
      "scope": "东南",
      "description": "/gn/ > /ŋ/ 写ң；旧 ogon 经次音节脱落 ogn 再同化",
      "example": "jagne→jaңe；ogon→ogn→oң",
      "caveat": "保留相关词汇历史层级，不得无根据把单独g或n写作ң"
    },
    {
      "id": "SE15",
      "scope": "东南",
      "description": "新祖语 *kʲ > ć，*dj > җ，*rʲ > r",
      "example": "*kʲuta→ćuta；*medja→meҗa；*rʲud→rud",
      "caveat": "源于不同的祖语对立"
    },
    {
      "id": "W11",
      "scope": "西部",
      "description": "词末 /ɣ/ 在元音之后脱落（词中、带词尾时不自动脱落）",
      "example": "sneġ→sne；boġ→bo；droġ→dro",
      "caveat": "造成词干与带格尾形的交替，后续重造范式"
    },
    {
      "id": "W12",
      "scope": "西部",
      "description": "/r/ 在 /θ/（þ）后强化为 /r̝/，写ř",
      "example": "þrub→þřub",
      "caveat": "先验证此辅音丛，不影响全部r"
    },
    {
      "id": "W13",
      "scope": "西部",
      "description": "词首 /ʒeɫ/ > /ʒɫ/ 的弱元音脱落",
      "example": "žełez→žłez",
      "caveat": "可能受语速及重音限制；先验证冶金词根"
    },
    {
      "id": "W14",
      "scope": "西部",
      "description": "新祖语 *kʲ > ǩ，*dj > ẑ，*rʲ > ř；软化辅音后u > ү",
      "example": "*kʲuta→ǩүt；*medja→meẑ；*rʲud→řүd",
      "caveat": "以具体祖语词根与音变路径为限"
    },
    {
      "id": "W15",
      "scope": "西部",
      "description": "沿用V0.5既有W09：多音节实词非重读-a词尾脱落",
      "example": "*kʲuta→ǩүt；*medja→meẑ",
      "caveat": "不能对所有单音节词或有意义格尾做任意删尾"
    }
  ],
